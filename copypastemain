  tempoAtual = millis(); // Atualiza o cronometro geral
// Verifica a conexão e atualiza o relógio
  if (WiFi.status() == WL_CONNECTED) {
    if (tempoUltimoNTP == 0 || (tempoAtual - tempoUltimoNTP >= INTERVALO_NTP)) {
      tempoUltimoNTP = tempoAtual;
      sincronizarNTP();
    }
  }
// Botão de reset físico
  if (digitalRead(BTN_RESET) == LOW) {
    Serial.println("[GREENHOUSE] Botão BOOT detectado. Mantenha pressionado por 5s para Reset...");
    unsigned long tPress = millis();
    bool resetOk = true;
    while (millis() - tPress < 5000) {
      if (digitalRead(BTN_RESET) == HIGH) { resetOk = false; break; }
      digitalWrite(LED_BUILTIN_PIN, !digitalRead(LED_BUILTIN_PIN));
      delay(100);
    }
    if (resetOk) {
      Serial.println("[GREENHOUSE] RESET DE FÁBRICA EXECUTADO!");
      prefs.begin("greenhouse", false);
      prefs.clear();
      prefs.end();
      for (int i = 0; i < 10; i++) {
        digitalWrite(LED_BUILTIN_PIN, HIGH); delay(50);
        digitalWrite(LED_BUILTIN_PIN, LOW); delay(50);
      }
      ESP.restart();
    }
  }
  server.handleClient(); 
// Mecanismo da conexão wifi  
  if (modoWifi == 1) {
    if (tentandoConectarWifi) {
      if (WiFi.status() == WL_CONNECTED) {
        tentandoConectarWifi = false;
        logMessage("[REDE] Conectado com sucesso! IP LAN: " + WiFi.localIP().toString());
        if (MDNS.begin("greenhouse-link")) {
          logMessage("[REDE] mDNS ativo: http://greenhouse-link.local");
        }
        WiFi.softAPdisconnect(true);
        WiFi.mode(WIFI_STA);
        logMessage("[REDE] AP de emergência desligado por segurança.");
      } else if (tempoAtual - tempoInicioConexaoWifi >= TIMEOUT_CONEXAO_WIFI) {
        tentandoConectarWifi = false;
        tempoUltimaTentativaWifi = tempoAtual;        
        WiFi.disconnect(false);
        WiFi.mode(WIFI_AP_STA);
        WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1);
        logMessage("[REDE] Falha na conexão Wi-Fi (20s timeout). AP mantido ativo no Canal 1.");
      } else {
        if (tempoAtual - tempoBlinkWifi >= 250) {
          tempoBlinkWifi = tempoAtual;
          digitalWrite(LED_BUILTIN_PIN, !digitalRead(LED_BUILTIN_PIN));
        }
      }
    } else {
      if (WiFi.status() != WL_CONNECTED) {
        if (WiFi.getMode() != WIFI_AP_STA && WiFi.getMode() != WIFI_AP) {
          WiFi.mode(WIFI_AP_STA);
          WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1);
          logMessage("[REDE] Conexão LAN perdida! AP de emergência reativado.");
        }
        if (tempoUltimaTentativaWifi == 0 || (tempoAtual - tempoUltimaTentativaWifi >= INTERVALO_RECONEXAO_WIFI)) {
          if (ssidSTA.length() > 0) {
            logMessage("[REDE] Tentando reconectar à rede Wi-Fi (" + ssidSTA + ")...");
            WiFi.begin(ssidSTA.c_str(), passSTA.c_str());
            tentandoConectarWifi = true;
            tempoInicioConexaoWifi = tempoAtual;
          }
        }
      }
    }
  }
// Mecanismo do relógio
  if (tempoAtual - tempoRelogio >= 60000) {
    tempoRelogio = tempoAtual;
    minutoSimulado++;
    if (minutoSimulado >= 60) {
      minutoSimulado = 0;
      horaSimulada++;
      if (horaSimulada >= 24) horaSimulada = 0;
    }
    if (automacaoAtiva) {
      processarIluminacao();
    }
  }
  // --- LEITURA DO SENSOR (DHT11 ou SCD30 com captura de CO2) ---
  // O ciclo é de 3 segundos (3000ms) para acompanhar a carga de leitura do SCD30
	if (tempoAtual - tempoSensor >= 3000) {
    tempoSensor = tempoAtual;
    leituraSucesso = false; // Utiliza a variável global
    // LÓGICA DE LEITURA
    if (usaSCD30) {
      if (airSensor.dataAvailable()) {
        temperaturaAtual = airSensor.getTemperature();
        umidadeAtual = airSensor.getHumidity();
        co2Atual = airSensor.getCO2();
        leituraSucesso = true;
      }
    } else if (usaDHT11) {
      float t = dht.readTemperature();
      float u = dht.readHumidity();
      if (!isnan(t) && !isnan(u)) {
        temperaturaAtual = t;
        umidadeAtual = u;
        leituraSucesso = true;
      }
    }
// PROCESSAMENTO DO LOG
    if (leituraSucesso) {
      // Loga os dados no console a cada 60 segundos
      if (tempoAtual - tempoLogSensor >= 60000 || tempoLogSensor == 0) {
        tempoLogSensor = tempoAtual;
    if ((umidadeAtual == 0) && (temperaturaAtual == 0)) {logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Leitura indisponível! Aguardando próximo ciclo...");}
    if ((umidadeAtual != 0) && (temperaturaAtual != 0)) {
        if (usaSCD30) {
          logMessage("[" + getHoraSimuladaString() + "] T:" + String(temperaturaAtual, 1) + "ºC | U:" + String(umidadeAtual, 0) + "% | CO2:" + String(co2Atual, 0) + "ppm");
        } else {
          logMessage("[" + getHoraSimuladaString() + "] T:" + String(temperaturaAtual, 1) + "ºC | U:" + String(umidadeAtual, 0) + "%");
        }}
      }
    } else {
      // Se falhar, avisa a cada 10 segundos para não inundar o console
      if (tempoAtual - tempoLogSensor >= 10000 || tempoLogSensor == 0) {
          tempoLogSensor = tempoAtual;
         if (automacaoAtiva) {
         logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Sensor indisponível! Atuadores de ambiente interrompidos...");
         digitalWrite(RELE_REFRIGERACAO, HIGH);
         digitalWrite(RELE_INJECAO_CO2, HIGH);
         digitalWrite(RELE_AQUECIMENTO, HIGH);
         digitalWrite(RELE_VENTILADOR, HIGH);
         digitalWrite(RELE_UMIDADE_1, HIGH);
         digitalWrite(RELE_UMIDADE_2, HIGH); 
         etapaUmidade = 0;
        } else {
         logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Sensor indisponível! Aguardando nova leitura...");
        }
      }
    }
  }
// Pisca LED automação ativa
  if (automacaoAtiva) { // executa tudo quando automação == ativa
	  if (tempoAtual - tempoLed >= 3000) { // tempo da rotina para executar itens dentro do loop
 	   tempoLed = tempoAtual;
 	   estadoLed = !estadoLed;
     verificarReconexaoSD(); // Verifica se cartão SD precisa reconectar 
 	   if (!tentandoConectarWifi) {
 	     digitalWrite(LED_BUILTIN_PIN, estadoLed);
 	   }
    // Segurança dos atuadores em caso de falha (não atuam)
    if (leituraSucesso) {
    // Lógica de Temperatura
      if (temperaturaAtual != 0) { 
        if (temperaturaAtual < (tempAlvo - tempMargem) && digitalRead(RELE_AQUECIMENTO) == HIGH) { 
          digitalWrite(RELE_AQUECIMENTO, LOW);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Baixa! Aquecimento LIGADO!");
        } else if (temperaturaAtual >= tempAlvo && digitalRead(RELE_AQUECIMENTO) == LOW) { 
          digitalWrite(RELE_AQUECIMENTO, HIGH);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Alvo atingida. Aquecimento DESL.");
        }
        if (temperaturaAtual > (tempAlvo + tempMargem) && digitalRead(RELE_REFRIGERACAO) == HIGH) {
          digitalWrite(RELE_REFRIGERACAO, LOW);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Alta! Refrigeração LIGADA!");
        } else if (temperaturaAtual <= tempAlvo && digitalRead(RELE_REFRIGERACAO) == LOW) {
          digitalWrite(RELE_REFRIGERACAO, HIGH);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Alvo atingida. Refrigeração DESL.");
        }
      }
    // Lógica do controle de CO2
      if (co2Atual>0){
        if (co2Atual > (co2Alvo + co2Margem) && digitalRead(RELE_VENTILADOR) == HIGH) {
          estadoVentilar = true;
          digitalWrite(RELE_VENTILADOR, LOW); 
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Nível de CO2 ELEVADO! Exaustão LIGADA!");
        } else if (co2Atual <= co2Alvo && digitalRead(RELE_VENTILADOR) == LOW) {
          estadoVentilar = false;
          digitalWrite(RELE_VENTILADOR, HIGH);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Nível de CO2 OK. Exaustão DESL.");
        }
        if (co2Atual < (co2Alvo - co2Margem) && digitalRead(RELE_INJECAO_CO2) == HIGH) {
          estadoInjecaoCO2 = true;
          digitalWrite(RELE_INJECAO_CO2, LOW);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Nível de CO2 BAIXO! Injeção ATIVADA!");
        } else if (co2Atual >= co2Alvo && digitalRead(RELE_INJECAO_CO2) == LOW) {
          estadoInjecaoCO2 = false;
          digitalWrite(RELE_INJECAO_CO2, HIGH);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] CO2 alvo alcançado. Injeção DESL.");
        }
      }
      // Acionamento do umidificador
      if (umidadeAtual > 0) {
        if (umidadeAtual < umidMinima) {
          precisaUmidificar = true;
        } else if (umidadeAtual >= (umidMinima + umidIdeal)) {
          if (precisaUmidificar) {
            logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Umid. Reestabelecida. Umidificador DESLIGADO.");
            precisaUmidificar = false;
            digitalWrite(RELE_UMIDADE_1, HIGH);
            digitalWrite(RELE_UMIDADE_2, HIGH);
            etapaUmidade = 0; 
          } else if (digitalRead(RELE_UMIDADE_1) == LOW) {
            logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Umid. OK. Umidificador DESLIGADO.");
            digitalWrite(RELE_UMIDADE_1, HIGH);
            digitalWrite(RELE_UMIDADE_2, HIGH);
            etapaUmidade = 0;
          }
        }
      }
    }
  }
    // Sequência de acionamento do umidificador e gatilho
    if (precisaUmidificar) {
      if (digitalRead(RELE_UMIDADE_1) == HIGH) {
          digitalWrite(RELE_UMIDADE_2, HIGH); 
          etapaUmidade = 0;
          }
      if (etapaUmidade == 0) {
        digitalWrite(RELE_UMIDADE_1, LOW); 
        cronometroUmidade = tempoAtual;    
        etapaUmidade = 1;                  
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Umid. baixa! Umidificador LIGADO!");
      } else if (etapaUmidade == 1) {
        if (tempoAtual - cronometroUmidade >= 1000) {
          digitalWrite(RELE_UMIDADE_2, LOW); 
          cronometroUmidade = tempoAtual;    
          etapaUmidade = 2; 
        }
      } else if (etapaUmidade == 2) {
        if (tempoAtual - cronometroUmidade >= 300) {
          digitalWrite(RELE_UMIDADE_2, HIGH); 
          etapaUmidade = 3;
        }
      }
    } else {
      if (etapaUmidade != 0) {
        digitalWrite(RELE_UMIDADE_1, HIGH);
        digitalWrite(RELE_UMIDADE_2, HIGH);
        etapaUmidade = 0;
        } 
      }
}
}
