void processarIluminacao() {
  if (!cicloAuto) return; 

  if (modoIluminacao == "Cogumelos") {
    digitalWrite(LUZ_VERMELHA, HIGH);
    digitalWrite(LUZ_BRANCA2, HIGH);
    digitalWrite(LUZ_VIOLETA, HIGH);

    if (horaSimulada >= 6 && horaSimulada < 18) {
      if (digitalRead(LUZ_BRANCA1) == HIGH) {
        digitalWrite(LUZ_BRANCA1, LOW);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Dia iniciado (ciclo Cogumelos) (06:00 - 18:00). Luz Branca 1 LIGADA!");
      }
    } else {
      if (digitalRead(LUZ_BRANCA1) == LOW) {
        digitalWrite(LUZ_BRANCA1, HIGH);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Noite iniciada (ciclo Cogumelos). Luz Branca 1 DESLIGADA.");
      }
    }
  } else if (modoIluminacao == "Plantas") {
    int mCurr = horaSimulada * 60 + minutoSimulado;
    int dMin = (int)(duracaoDia * 60.0);
    int mStart = 720 - (dMin / 2); 
    int mEnd = 720 + (dMin / 2);

    bool eNoite = (mCurr < mStart || mCurr >= mEnd);

    if (eNoite) {
      digitalWrite(LUZ_VERMELHA, HIGH);
      digitalWrite(LUZ_BRANCA1, HIGH);
      digitalWrite(LUZ_BRANCA2, HIGH);
      digitalWrite(LUZ_VIOLETA, HIGH);
    } else {
      int p10 = dMin * 0.10;
      int p4  = dMin * 0.04;

      bool verm = (mCurr < (mStart + p10)) || (mCurr >= (mEnd - p10));
      bool b1   = (mCurr >= (mStart + p4))  && (mCurr < (mEnd - p4));
      bool b2   = (mCurr >= (mStart + p10)) && (mCurr < (mEnd - p10));
      bool viol = (mCurr >= (720 - p10))    && (mCurr < (720 + p10));

      digitalWrite(LUZ_VERMELHA, verm ? LOW : HIGH);
      digitalWrite(LUZ_BRANCA1, b1 ? LOW : HIGH);
      digitalWrite(LUZ_BRANCA2, b2 ? LOW : HIGH);
      digitalWrite(LUZ_VIOLETA, viol ? LOW : HIGH);
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_BUILTIN_PIN, OUTPUT);
  pinMode(BTN_RESET, INPUT_PULLUP);
  
  pinMode(RELE_AQUECIMENTO, OUTPUT);
  pinMode(RELE_VENTILADOR, OUTPUT);
  pinMode(RELE_UMIDADE_1, OUTPUT);
  pinMode(RELE_UMIDADE_2, OUTPUT);
  
  pinMode(LUZ_BRANCA1, OUTPUT);
  pinMode(LUZ_VERMELHA, OUTPUT);
  pinMode(LUZ_BRANCA2, OUTPUT);
  pinMode(LUZ_VIOLETA, OUTPUT);

  digitalWrite(RELE_AQUECIMENTO, HIGH);
  digitalWrite(RELE_VENTILADOR, HIGH);
  digitalWrite(RELE_UMIDADE_1, HIGH);
  digitalWrite(RELE_UMIDADE_2, HIGH);
  digitalWrite(LUZ_BRANCA1, HIGH);
  digitalWrite(LUZ_VERMELHA, HIGH);
  digitalWrite(LUZ_BRANCA2, HIGH);
  digitalWrite(LUZ_VIOLETA, HIGH);

  logMessage("[GREENHOUSE] Sistema iniciado...");
  dht.begin();

  carregarConfiguracoesRede();

  prefs.begin("greenhouse", true);
  String savedPerfil = prefs.getString("perfil_ativo", "Frutificação");
  prefs.end();

  carregarPerfil(savedPerfil);

  // Inicialização Wi-Fi
  WiFi.persistent(false); // Desabilita gravações repetitivas no Flash do ESP32
  
  if (modoWifi == 0) {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1); // Força Canal 1 para estabilidade
    logMessage("[GREENHOUSE] Modo Apenas AP Ativo. IP: " + WiFi.softAPIP().toString());
  } else {
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1); // Canal 1 fixo
    logMessage("[GREENHOUSE] AP de Emergência Habilitado: " + ssidAP + " (IP: " + WiFi.softAPIP().toString() + ")");

    if (ssidSTA.length() > 0) {
      logMessage("[REDE] Conectando à rede Wi-Fi: " + ssidSTA + "...");
      WiFi.begin(ssidSTA.c_str(), passSTA.c_str());
      tentandoConectarWifi = true;
      tempoInicioConexaoWifi = millis();
    } else {
      logMessage("[REDE] Modo Cliente selecionado, mas nenhum SSID configurado.");
    }
  }

  logMessage("[SISTEMA] Cultivo de " + modoIluminacao + " configurado.");
  logMessage("[SISTEMA] Perfil inicial Carregado: " + perfilAtivo + " (T: " + String(tempAlvo,1) + "ºC / U: " + String(umidMinima,1) + "%)");

  server.on("/", handleRoot);
  server.on("/status", handleStatus);
  server.on("/toggleAutomacao", handleToggleAutomacao);
  server.on("/togglePino", handleTogglePino);
  server.on("/setPerfil", handleSetPerfil);
  server.on("/toggleCicloAuto", handleToggleCicloAuto);
  server.on("/setModoIlu", handleSetModoIluminacao);
  server.on("/setDuracaoDia", handleSetDuracaoDia);
  server.on("/setTempAlvo", handleSetTempAlvo);
  server.on("/setUmidMin", handleSetUmidMin);
  server.on("/restaurarPerfil", handleRestaurarPerfil);
  server.on("/setHora", handleSetHora);

  server.on("/set_wifi_mode", HTTP_POST, handleSetWifiMode);
  server.on("/set_ap_creds", HTTP_POST, handleSetApCreds);
  server.on("/set_sta_creds", HTTP_POST, handleSetStaCreds);
  server.on("/restart", handleRestart);
  
  server.begin();
  logMessage("[GREENHOUSE] Web Server rodando na porta 80 padrão.");
}

void loop() {
  if (digitalRead(BTN_RESET) == LOW) {
    Serial.println("[RESET] Botão BOOT detectado. Mantenha pressionado por 5s para Reset...");
    unsigned long tPress = millis();
    bool resetOk = true;
    while (millis() - tPress < 5000) {
      if (digitalRead(BTN_RESET) == HIGH) { resetOk = false; break; }
      digitalWrite(LED_BUILTIN_PIN, !digitalRead(LED_BUILTIN_PIN));
      delay(100);
    }
    if (resetOk) {
      Serial.println("[SISTEMA] RESET DE FÁBRICA EXECUTADO!");
      prefs.begin("greenhouse", false);
      prefs.clear();
      prefs.end();
      for (int i = 0; i < 10; i++) {
        digitalWrite(LED_BUILTIN_PIN, HIGH); delay(50);
        digitalWrite(LED_BUILTIN_PIN, LOW); delay(50);
      }
      ESP.restart();
    }
  }

  server.handleClient(); 
  unsigned long tempoAtual = millis();

  // Máquina de Estados Não-Bloqueante para Wi-Fi (STA + AP)
  if (modoWifi == 1) {
    if (tentandoConectarWifi) {
      if (WiFi.status() == WL_CONNECTED) {
        tentandoConectarWifi = false;
        logMessage("[REDE] Conectado com sucesso! IP LAN: " + WiFi.localIP().toString());
        if (MDNS.begin("greenhouse-link")) {
          logMessage("[REDE] mDNS ativo: http://greenhouse-link.local");
        }
        WiFi.softAPdisconnect(true);
        WiFi.mode(WIFI_STA);
        logMessage("[REDE] AP de emergência desligado por segurança.");
      } else if (tempoAtual - tempoInicioConexaoWifi >= TIMEOUT_CONEXAO_WIFI) {
        tentandoConectarWifi = false;
        tempoUltimaTentativaWifi = tempoAtual;
        
        // Interrompe a varredura do rádio para travar o canal do SoftAP
        WiFi.disconnect(false);
        WiFi.mode(WIFI_AP_STA);
        WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1);
        
        logMessage("[REDE] Falha na conexão Wi-Fi (20s timeout). AP mantido ativo no Canal 1.");
      } else {
        if (tempoAtual - tempoBlinkWifi >= 250) {
          tempoBlinkWifi = tempoAtual;
          digitalWrite(LED_BUILTIN_PIN, !digitalRead(LED_BUILTIN_PIN));
        }
      }
    } else {
      if (WiFi.status() == WL_CONNECTED) {
        // Conexão estável em STA
      } else {
        // Se perdeu a conexão ou expirou o tempo de espera
        if (WiFi.getMode() != WIFI_AP_STA && WiFi.getMode() != WIFI_AP) {
          WiFi.mode(WIFI_AP_STA);
          WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1);
          logMessage("[REDE] Conexão LAN perdida! AP de emergência reativado.");
        }

        // Tenta reconectar a cada 5 minutos
        if (tempoUltimaTentativaWifi == 0 || (tempoAtual - tempoUltimaTentativaWifi >= INTERVALO_RECONEXAO_WIFI)) {
          if (ssidSTA.length() > 0) {
            logMessage("[REDE] Tentando reconectar à rede Wi-Fi (" + ssidSTA + ")...");
            WiFi.begin(ssidSTA.c_str(), passSTA.c_str());
            tentandoConectarWifi = true;
            tempoInicioConexaoWifi = tempoAtual;
          }
        }
      }
    }
  }

  if (tempoAtual - tempoLed >= 1000) {
    tempoLed = tempoAtual;
    estadoLed = !estadoLed;
    if (automacaoAtiva && !tentandoConectarWifi) {
      digitalWrite(LED_BUILTIN_PIN, estadoLed);
    }
  }

  // Relógio Simulado
  if (tempoAtual - tempoRelogio >= 60000) {
    tempoRelogio = tempoAtual;
    minutoSimulado++;
    if (minutoSimulado >= 60) {
      minutoSimulado = 0;
      horaSimulada++;
      if (horaSimulada >= 24) horaSimulada = 0;
    }
    if (automacaoAtiva) {
      processarIluminacao();
    }
  }

  static unsigned long tempoSensor = 0;
  static unsigned long tempoLogSensor = 0;
  if (tempoAtual - tempoSensor >= 3000) {
    tempoSensor = tempoAtual;
    float u = dht.readHumidity();
    float t = dht.readTemperature();

    if (!isnan(u) && !isnan(t)) {
      umidadeAtual = u;
      temperaturaAtual = t;

      if (tempoAtual - tempoLogSensor >= 60000 || tempoLogSensor == 0) {
        tempoLogSensor = tempoAtual;
        logMessage("[" + getHoraSimuladaString() + "] T:" + String(temperaturaAtual, 1) + "ºC | U:" + String(umidadeAtual, 0) + "%");
      }
    } else {
      if (tempoAtual - tempoLogSensor >= 10000) {
        tempoLogSensor = tempoAtual;
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] ERRO: Falha de leitura no sensor DHT!");
      }
    }
  }

  // Malha de Automação
  if (automacaoAtiva) {
    if (temperaturaAtual > 0) { 
      if (temperaturaAtual < (tempAlvo - TEMP_MARGEM)) {
        if (digitalRead(RELE_AQUECIMENTO) == HIGH) { 
          digitalWrite(RELE_AQUECIMENTO, LOW);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Baixa! Aquecimento LIGADO!");
        }
      } else if (temperaturaAtual >= tempAlvo) {
        if (digitalRead(RELE_AQUECIMENTO) == LOW) { 
          digitalWrite(RELE_AQUECIMENTO, HIGH);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Alvo atingida. Aquecimento DESL.");
        }
      }

      if (temperaturaAtual > (tempAlvo + TEMP_MARGEM)) {
        if (digitalRead(RELE_VENTILADOR) == HIGH) {
          digitalWrite(RELE_VENTILADOR, LOW);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Alta! Ventilador LIGADO!");
        }
      } else if (temperaturaAtual <= tempAlvo) {
        if (digitalRead(RELE_VENTILADOR) == LOW) {
          digitalWrite(RELE_VENTILADOR, HIGH);
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Temp. Alvo atingida. Ventilador DESL.");
        }
      }
    }

    if (umidadeAtual > 0) {
      if (umidadeAtual < umidMinima) {
        precisaUmidificar = true;
      } else if (umidadeAtual >= (umidMinima + 5.0)) {
        if (precisaUmidificar) {
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Umid. Reestabelecida. Umidificador DESLIGADO.");
          precisaUmidificar = false;
          digitalWrite(RELE_UMIDADE_1, HIGH);
          digitalWrite(RELE_UMIDADE_2, HIGH);
          etapaUmidade = 0; 
        } else if (digitalRead(RELE_UMIDADE_1) == LOW) {
          logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Umid. OK. Umidificador DESLIGADO.");
          digitalWrite(RELE_UMIDADE_1, HIGH);
          digitalWrite(RELE_UMIDADE_2, HIGH);
          etapaUmidade = 0;
        }
      }
    }

    if (precisaUmidificar) {
      if (etapaUmidade == 0) {
        digitalWrite(RELE_UMIDADE_1, LOW); 
        cronometroUmidade = tempoAtual;    
        etapaUmidade = 1;                  
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Umid. baixa! Umidificador LIGADO!");
      } else if (etapaUmidade == 1) {
        if (tempoAtual - cronometroUmidade >= 1000) {
          digitalWrite(RELE_UMIDADE_2, LOW); 
          cronometroUmidade = tempoAtual;    
          etapaUmidade = 2; 
        }
      } else if (etapaUmidade == 2) {
        if (tempoAtual - cronometroUmidade >= 300) {
          digitalWrite(RELE_UMIDADE_2, HIGH); 
          etapaUmidade = 3;
        }
      }
    } else {
      if (etapaUmidade != 0) {
        digitalWrite(RELE_UMIDADE_1, HIGH);
        digitalWrite(RELE_UMIDADE_2, HIGH);
        etapaUmidade = 0;
      }
    }
  }
}
