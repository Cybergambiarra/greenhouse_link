// Buffer do monitor serial
String serialBuffer = "";
const size_t MAX_BUFFER_SIZE = 5000;

void logMessage(String msg) {
  Serial.println(msg);
  serialBuffer += msg + "\n";
  if (serialBuffer.length() > MAX_BUFFER_SIZE) {
    serialBuffer = serialBuffer.substring(serialBuffer.length() - MAX_BUFFER_SIZE);
  }
}

String getUptimeString() {
  unsigned long totalSegundos = millis() / 1000;
  unsigned long dias = totalSegundos / 86400;
  unsigned long horas = (totalSegundos % 86400) / 3600;
  unsigned long minutos = (totalSegundos % 3600) / 60;

  char relogio[20];
  snprintf(relogio, sizeof(relogio), "%03lu:%02lu:%02lu", dias, horas, minutos);
  return String(relogio);
}

String getHoraSimuladaString() {
  char buf[10];
  snprintf(buf, sizeof(buf), "%02d:%02d", horaSimulada, minutoSimulado);
  return String(buf);
}

void processarIluminacao();

void carregarConfiguracoesRede() {
  prefs.begin("greenhouse", true);
  modoWifi = prefs.getInt("modo_wifi", 0);
  ssidAP = prefs.getString("ssid_ap", "Greenhouse_link");
  passAP = prefs.getString("pass_ap", "Conecta!");
  ssidSTA = prefs.getString("ssid_sta", "");
  passSTA = prefs.getString("pass_sta", "");
  prefs.end();
}

void carregarPerfil(String perfil) {
  prefs.begin("greenhouse", true);
  if (perfil == "Incubação") {
    tempAlvo = prefs.getFloat("inc_t", 22.0);
    umidMinima = prefs.getFloat("inc_u", 65.0);
    cicloAuto = prefs.getBool("inc_c", false);
  } else if (perfil == "Frutificação") {
    tempAlvo = prefs.getFloat("frut_t", 18.0);
    umidMinima = prefs.getFloat("frut_u", 90.0);
    cicloAuto = prefs.getBool("frut_c", true);
  } else if (perfil == "Personalizado") {
    tempAlvo = prefs.getFloat("pers_t", 20.0);
    umidMinima = prefs.getFloat("pers_u", 75.0);
    cicloAuto = prefs.getBool("pers_c", true);
  }
  
  modoIluminacao = prefs.getString("modo_ilu", "Cogumelos");
  duracaoDia = prefs.getFloat("dur_dia", 12.0);
  prefs.end();

  perfilAtivo = perfil;

  prefs.begin("greenhouse", false);
  prefs.putString("perfil_ativo", perfilAtivo);
  prefs.end();

  if (automacaoAtiva) processarIluminacao();
}

void salvarPerfilAtivo(float t, float u, bool c) {
  prefs.begin("greenhouse", false);
  if (perfilAtivo == "Incubação") {
    prefs.putFloat("inc_t", t);
    prefs.putFloat("inc_u", u);
    prefs.putBool("inc_c", c);
  } else if (perfilAtivo == "Frutificação") {
    prefs.putFloat("frut_t", t);
    prefs.putFloat("frut_u", u);
    prefs.putBool("frut_c", c);
  } else if (perfilAtivo == "Personalizado") {
    prefs.putFloat("pers_t", t);
    prefs.putFloat("pers_u", u);
    prefs.putBool("pers_c", c);
  }
  
  prefs.putString("modo_ilu", modoIluminacao);
  prefs.putFloat("dur_dia", duracaoDia);
  prefs.putString("perfil_ativo", perfilAtivo);
  prefs.end();

  tempAlvo = t;
  umidMinima = u;
  cicloAuto = c;

  if (automacaoAtiva) processarIluminacao();
}

void restaurarFabricaPerfilAtivo() {
  prefs.begin("greenhouse", false);
  if (perfilAtivo == "Incubação") {
    prefs.putFloat("inc_t", 22.0); prefs.putFloat("inc_u", 65.0); prefs.putBool("inc_c", false);
    tempAlvo = 22.0; umidMinima = 65.0; cicloAuto = false;
  } else if (perfilAtivo == "Frutificação") {
    prefs.putFloat("frut_t", 18.0); prefs.putFloat("frut_u", 90.0); prefs.putBool("frut_c", true);
    tempAlvo = 18.0; umidMinima = 90.0; cicloAuto = true;
  } else if (perfilAtivo == "Personalizado") {
    prefs.putFloat("pers_t", 20.0); prefs.putFloat("pers_u", 75.0); prefs.putBool("pers_c", true);
    tempAlvo = 20.0; umidMinima = 75.0; cicloAuto = true;
  }
  
  modoIluminacao = "Cogumelos";
  duracaoDia = 12.0;
  prefs.putString("modo_ilu", modoIluminacao);
  prefs.putFloat("dur_dia", duracaoDia);
  prefs.end();

  if (automacaoAtiva) processarIluminacao();
}

void handleStatus() {
  String json = "{";
  json += "\"temp\":\"" + String(temperaturaAtual, 1) + "\",";
  json += "\"umid\":\"" + String(umidadeAtual, 1) + "\",";
  json += "\"horaSim\":\"" + getHoraSimuladaString() + "\",";
  json += "\"uptime\":\"" + getUptimeString() + "\",";
  json += "\"tAlvo\":\"" + String(tempAlvo, 1) + "\",";
  json += "\"uMin\":\"" + String(umidMinima, 1) + "\",";
  json += "\"perfil\":\"" + perfilAtivo + "\",";
  json += "\"modoIlu\":\"" + modoIluminacao + "\",";
  json += "\"durDia\":\"" + String(duracaoDia, 1) + "\",";
  json += "\"cAuto\":" + String(cicloAuto ? "true" : "false") + ",";
  json += "\"auto\":" + String(automacaoAtiva ? "true" : "false") + ",";
  json += "\"aq\":" + String(digitalRead(RELE_AQUECIMENTO) == LOW ? "true" : "false") + ",";
  json += "\"ven\":" + String(digitalRead(RELE_VENTILADOR) == LOW ? "true" : "false") + ",";
  json += "\"um1\":" + String(digitalRead(RELE_UMIDADE_1) == LOW ? "true" : "false") + ",";
  json += "\"um2\":" + String(digitalRead(RELE_UMIDADE_2) == LOW ? "true" : "false") + ",";
  json += "\"lB1\":" + String(digitalRead(LUZ_BRANCA1) == LOW ? "true" : "false") + ",";
  json += "\"lVerm\":" + String(digitalRead(LUZ_VERMELHA) == LOW ? "true" : "false") + ",";
  json += "\"lB2\":" + String(digitalRead(LUZ_BRANCA2) == LOW ? "true" : "false") + ",";
  json += "\"lViol\":" + String(digitalRead(LUZ_VIOLETA) == LOW ? "true" : "false") + ",";
  json += "\"led\":" + String(digitalRead(LED_BUILTIN_PIN) == HIGH ? "true" : "false") + ",";
  
  String logEscaped = serialBuffer;
  logEscaped.replace("\\", "\\\\");
  logEscaped.replace("\"", "\\\"");
  logEscaped.replace("\n", "\\n");
  logEscaped.replace("\r", "");
  
  json += "\"log\":\"" + logEscaped + "\"";
  json += "}";
  
  server.send(200, "application/json", json);
}

void handleToggleAutomacao() {
  automacaoAtiva = !automacaoAtiva;
  if (automacaoAtiva) {
    logMessage("[SISTEMA] Automação REATIVADA pelo usuário!");
    processarIluminacao();
  } else {
    logMessage("[SISTEMA] Automação PAUSADA! Modo Manual/Configuração Ativo!");
  }
  server.send(200, "text/plain", "OK");
}

void handleTogglePino() {
  if (!automacaoAtiva && server.hasArg("pin")) {
    int pin = server.arg("pin").toInt();
    int estadoAtual = digitalRead(pin);
    digitalWrite(pin, !estadoAtual);
    logMessage("[MANUAL] Pino GPIO " + String(pin) + " alterado para " + String(!estadoAtual ? "LOW" : "HIGH"));
  }
  server.send(200, "text/plain", "OK");
}

void handleSetPerfil() {
  if (!automacaoAtiva && server.hasArg("p")) {
    String p = server.arg("p");
    if (p == "inc") carregarPerfil("Incubação");
    else if (p == "frut") carregarPerfil("Frutificação");
    else if (p == "pers") carregarPerfil("Personalizado");
    logMessage("[CONFIG] Perfil alterado para " + perfilAtivo);
  }
  server.send(200, "text/plain", "OK");
}

void handleToggleCicloAuto() {
  if (!automacaoAtiva) {
    cicloAuto = !cicloAuto;
    salvarPerfilAtivo(tempAlvo, umidMinima, cicloAuto);
    logMessage("[CONFIG] Ciclo Dia/Noite do perfil " + perfilAtivo + " alterado para: " + String(cicloAuto ? "AUTOMÁTICO" : "MANUAL"));
  }
  server.send(200, "text/plain", "OK");
}

void handleSetModoIluminacao() {
  if (!automacaoAtiva && server.hasArg("m")) {
    String m = server.arg("m");
    if (m == "Cogumelos" || m == "Plantas") {
      modoIluminacao = m;
      prefs.begin("greenhouse", false);
      prefs.putString("modo_ilu", modoIluminacao);
      prefs.end();
      logMessage("[CONFIG] Perfil de Ciclo de dia alterado para \"" + modoIluminacao + "\"!");
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleSetDuracaoDia() {
  if (!automacaoAtiva && server.hasArg("d")) {
    float d = server.arg("d").toFloat();
    if (d >= 1.0 && d <= 23.0) {
      duracaoDia = d;
      prefs.begin("greenhouse", false);
      prefs.putFloat("dur_dia", duracaoDia);
      prefs.end();
      logMessage("[CONFIG] Duração do ciclo dia ajustada para " + String(duracaoDia, 1) + " horas.");
    } else {
      logMessage("[ERRO] Duração do dia deve ser entre 1.0 e 23.0 horas!");
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleSetTempAlvo() {
  if (!automacaoAtiva && server.hasArg("t")) {
    float nTemp = server.arg("t").toFloat();
    if (nTemp >= 9.0 && nTemp <= 48.0) {
      tempAlvo = nTemp;
      salvarPerfilAtivo(tempAlvo, umidMinima, cicloAuto);
      logMessage("[CONFIG] Temperatura Alvo alterada para " + String(tempAlvo, 1) + "ºC no perfil " + perfilAtivo);
    } else {
      logMessage("[ERRO] Temperatura fora dos limites de segurança (9ºC a 48ºC)!");
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleSetUmidMin() {
  if (!automacaoAtiva && server.hasArg("u")) {
    float nUmid = server.arg("u").toFloat();
    if (nUmid >= 10.0 && nUmid <= 90.0) {
      umidMinima = nUmid;
      salvarPerfilAtivo(tempAlvo, umidMinima, cicloAuto);
      logMessage("[CONFIG] Umidade Mínima alterada para " + String(umidMinima, 1) + "% no perfil " + perfilAtivo);
    } else {
      logMessage("[ERRO] Umidade fora dos limites de segurança (10% a 90%)!");
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleRestaurarPerfil() {
  if (!automacaoAtiva) {
    restaurarFabricaPerfilAtivo();
    logMessage("[CONFIG] Padrões de fábrica restaurados para o perfil " + perfilAtivo);
  }
  server.send(200, "text/plain", "OK");
}

void handleSetHora() {
  if (!automacaoAtiva && server.hasArg("h") && server.hasArg("m")) {
    int h = server.arg("h").toInt();
    int m = server.arg("m").toInt();
    if (h >= 0 && h <= 23 && m >= 0 && m <= 59) {
      horaSimulada = h;
      minutoSimulado = m;
      tempoRelogio = millis(); 
      logMessage("[CONFIG] Hora simulada ajustada para " + getHoraSimuladaString());
      if (automacaoAtiva) processarIluminacao();
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleSetWifiMode() {
  if (server.hasArg("mode")) {
    modoWifi = server.arg("mode").toInt();
    prefs.begin("greenhouse", false);
    prefs.putInt("modo_wifi", modoWifi);
    prefs.end();
    logMessage("[REDE] Modo alterado para " + String(modoWifi == 0 ? "Apenas AP" : "Cliente STA + AP Automático") + ". Reinicie o ESP32.");
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleSetApCreds() {
  if (server.hasArg("ssid") && server.hasArg("pass")) {
    String nSsid = server.arg("ssid");
    String nPass = server.arg("pass");
    if (nPass.length() >= 8) {
      ssidAP = nSsid;
      passAP = nPass;
      prefs.begin("greenhouse", false);
      prefs.putString("ssid_ap", ssidAP);
      prefs.putString("pass_ap", passAP);
      prefs.end();
      logMessage("[REDE] Novas credenciais AP salvas! Reinicie o ESP32 para aplicar.");
    } else {
      logMessage("[ERRO] Senha do AP precisa ter no mínimo 8 caracteres!");
    }
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleSetStaCreds() {
  if (server.hasArg("ssid") && server.hasArg("pass")) {
    ssidSTA = server.arg("ssid");
    passSTA = server.arg("pass");
    modoWifi = 1;
    prefs.begin("greenhouse", false);
    prefs.putString("ssid_sta", ssidSTA);
    prefs.putString("pass_sta", passSTA);
    prefs.putInt("modo_wifi", modoWifi);
    prefs.end();
    logMessage("[REDE] Credenciais Wi-Fi e Modo Cliente salvos! Reinicie o ESP32 para conectar.");
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleRestart() {
  logMessage("[SISTEMA] Reinicialização solicitada via Web interface...");
  server.send(200, "text/plain", "OK");
  delay(1000);
  ESP.restart();
}

