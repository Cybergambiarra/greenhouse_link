// Configuração umidade
void handleSetUmidMin() {
  if (configuracoesDesbloqueadas && server.hasArg("u")) {
    float nUmid = server.arg("u").toFloat();
    if ((nUmid + umidIdeal) <= 95.0 && nUmid >= 10.0 && nUmid <= 94.0) {
      umidMinima = nUmid;
      salvarPerfilAtivo(tempAlvo, umidMinima, cicloAuto, co2Alvo);
      logMessage("[CONFIG] Umidade Mínima alterada para " + String(umidMinima, 1) + "% no perfil " + perfilAtivo + getClientDetails());
    } else {
      logMessage("[ERRO] Umidade fora dos limites de segurança (mínimo 10% a mínima + margem = 94%)!" + getClientDetails());
    }
  }
  server.send(200, "text/plain", "OK");
}
void handleSetUmidIdeal() {
  if (configuracoesDesbloqueadas && server.hasArg("ui")) {
    float nUi = server.arg("ui").toFloat();
    if ((umidMinima + nUi) <= 95.0 && nUi >= 0.0 && nUi <= 30.0) {
      umidIdeal = nUi;
      salvarParametrosGeraisPerfil();
      logMessage("[CONFIG] Margem de Desligamento de Umidade alterada para +" + String(umidIdeal, 1) + "%" + getClientDetails());
    } else {
      logMessage("[ERRO] Margem de umidade fora dos limites (mínimo 0% a mínima + margem = 94%)!" + getClientDetails());
    }
  }
  server.send(200, "text/plain", "OK");
}
// Ajuste manual do relógio
void handleSetHora() {
  if (configuracoesDesbloqueadas && server.hasArg("h") && server.hasArg("m")) {
    int h = server.arg("h").toInt();
    int m = server.arg("m").toInt();
    if (h >= 0 && h <= 23 && m >= 0 && m <= 59) {
      horaSimulada = h;
      minutoSimulado = m;
      tempoRelogio = millis(); 
      logMessage("[CONFIG] Hora simulada ajustada para " + getHoraSimuladaString() + getClientDetails());
    }
  }
  server.send(200, "text/plain", "OK");
}
// Ajuste automático do relógio via NTP (quando conectado a internet)
void sincronizarNTP() {
  if (WiFi.status() == WL_CONNECTED) {
    configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
    struct tm timeinfo;
    if (getLocalTime(&timeinfo)) {
      horaSimulada = timeinfo.tm_hour;
      minutoSimulado = timeinfo.tm_min;
      tempoRelogio = millis(); 
      logMessage("[NTP] Hora oficial sincronizada com sucesso: " + getHoraSimuladaString());
    } else {
      logMessage("[NTP] Falha ao obter hora do servidor NTP.");
    }
  }
}
