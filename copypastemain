// Adiciona a mensagem caractere por caractere ao buffer circular de forma ultrarrápida
void adicionarAoBufferLog(const String& msg) {
  for (size_t i = 0; i < msg.length(); i++) {
    logBuffer[logHead] = msg[i];
    logHead = (logHead + 1) % LOG_BUFFER_SIZE;
    if (logHead == 0) logBufferCheio = true;
  }
  // Adiciona a quebra de linha no final da mensagem
  logBuffer[logHead] = '\n';
  logHead = (logHead + 1) % LOG_BUFFER_SIZE;
  if (logHead == 0) logBufferCheio = true;
}
// Monta a string no formato correto escapando caracteres especiais para o JSON
String getLogEscapedJSON() {
  String out = "";
  out.reserve(LOG_BUFFER_SIZE * 1.1); // Pre-aloca memória contígua uma única vez
  size_t start = logBufferCheio ? logHead : 0;
  size_t total = logBufferCheio ? LOG_BUFFER_SIZE : logHead;
  for (size_t i = 0; i < total; i++) {
    char c = logBuffer[(start + i) % LOG_BUFFER_SIZE];
    if (c == '\\') out += "\\\\";
    else if (c == '"') out += "\\\"";
    else if (c == '\n') out += "\\n";
    else if (c == '\r') continue;
    else out += c;
  }
  return out;
}
// Log do monitor serial e gravação no SD
void logMessage(String msg) {
  Serial.println(msg);
  adicionarAoBufferLog(msg);
  gravarLogSD(msg);
}
// Inicializa e verifica a presença do Cartão SD
void inicializarSD() {
  if (!SD.begin(SD_CS_PIN)) {
    logMessage("[GREENHOUSE] Cartão SD não detectado! Operando apenas com memória RAM.");
    sdDisponivel = false;
    return;
  }
  uint8_t cardType = SD.cardType();
  if (cardType == CARD_NONE) {
    logMessage("[SISTEMA] Erro de cartão no slot (precisa estar formatado em FAT32).");
    sdDisponivel = false;
    return;
  }
  logMessage("[SISTEMA] Cartão SD montado e pronto para uso.");
  sdDisponivel = true;
}
// Gera o nome do arquivo log.txt para cartão sd usando o relógio NTP ou Tempo Ligado (uptime)
String getNomeArquivoLog() {
  // Se o NTP ainda não sincronizou, usa o nome por uptime
  if (!ntpSincronizado) {
    unsigned long diasUptime = millis() / 86400000UL;
    char bufferSemData[32];
    snprintf(bufferSemData, sizeof(bufferSemData), "/log_sem_data_%03lu.txt", diasUptime);
    return String(bufferSemData);
  }
  // Se já sincronizou, lê o RTC interno na RAM (ultra rápido)
  time_t now;
  struct tm timeinfo;
  time(&now);
  localtime_r(&now, &timeinfo);
  char buffer[24];
  strftime(buffer, sizeof(buffer), "/log%Y%m%d.txt", &timeinfo);
  return String(buffer);
}
// Descarrega o lote acumulado na RAM fisicamente para o cartão SD
void flushLogSD() {
  if (sdBatchPos == 0 || !sdDisponivel) return;
  String caminhoArquivo = getNomeArquivoLog();
  File file = SD.open(caminhoArquivo.c_str(), FILE_APPEND);
  if (file) {
    file.write((uint8_t*)sdBatchBuffer, sdBatchPos);
    file.close(); // Fecha o arquivo fisicamente no SD
  } else {
    Serial.print("[SISTEMA] Erro ao gravar buffer no SD: ");
    Serial.println(caminhoArquivo);
  }
  sdBatchPos = 0;
  ultimoFlushSD = millis();
}
// Checa se o tempo limite de 90 segundos expirou para descarregar o lote
void verificarFlushSD() {
  if (sdBatchPos > 0 && (millis() - ultimoFlushSD >= INTERVALO_FLUSH_SD)) {
    flushLogSD();
  }
}
// Acumula as mensagens na RAM sem abrir o SD imediatamente
void gravarLogSD(const String& mensagem) {
  if (!sdDisponivel) return;
  char timeStamp[25] = "[0000-00-00] ";
  if (ntpSincronizado) {
    time_t now;
    struct tm timeinfo;
    time(&now);
    localtime_r(&now, &timeinfo);
    strftime(timeStamp, sizeof(timeStamp), "[%Y-%m-%d ] ", &timeinfo);
  }
  String linhaFormatada = String(timeStamp) + mensagem + "\n";
  size_t tamanhoLinha = linhaFormatada.length();
  // Se a nova linha estourar o limite do setor (512 bytes), força a gravação no SD
  if (sdBatchPos + tamanhoLinha >= SD_BATCH_SIZE) {
    flushLogSD();
  }
  // Copia os caracteres para o buffer acumulador na RAM
  for (size_t i = 0; i < tamanhoLinha; i++) {
    sdBatchBuffer[sdBatchPos++] = linhaFormatada[i];
  }
}
// Reconecta cartão SD em caso de falha
void verificarReconexaoSD() {
  // Se o SD caiu, tenta reconectar apenas 1 vez a cada 5 minutos
  if (!sdDisponivel && (millis() - ultimoTesteSD > 300000)) {
    ultimoTesteSD = millis();
    if (SD.begin(SD_CS_PIN)) {
      sdDisponivel = true;
      Serial.println("[GREENHOUSE] Cartão reconectado com sucesso!");
    }
  }
}
// Remove logs com mais de X dias de idade para manter o SD interface web prática
void limparLogsAntigos(int diasRetencao = 90) {
  if (!sdDisponivel || !ntpSincronizado) return;
  time_t now;
  time(&now);
  File root = SD.open("/");
  File file = root.openNextFile();
  while (file) {
    if (!file.isDirectory()) {
      String nome = String(file.name());
      if (!nome.startsWith("/")) nome = "/" + nome;
      // Processa apenas arquivos no formato /logYYYYMMDD.txt
      if (nome.startsWith("/log20") && nome.endsWith(".txt") && nome.length() == 16) {
        int ano = nome.substring(4, 8).toInt();
        int mes = nome.substring(8, 10).toInt();
        int dia = nome.substring(10, 12).toInt();
        struct tm dataLog = {0};
        dataLog.tm_year = ano - 1900;
        dataLog.tm_mon = mes - 1;
        dataLog.tm_mday = dia;
        time_t tempoLog = mktime(&dataLog);
        double diferencaDias = difftime(now, tempoLog) / 86400.0;
        if (diferencaDias > diasRetencao) {
          String caminhoParaDeletar = nome;
          File proximo = root.openNextFile();
          file.close();
          SD.remove(caminhoParaDeletar);
          logMessage("[SD] Log antigo removido automaticamente: " + caminhoParaDeletar);
          file = proximo;
          continue;
        }
      }
    }
    File proximo = root.openNextFile();
    file.close();
    file = proximo;
  }
}
// matemática do tempo ligado
String getUptimeString() { 
  unsigned long totalSegundos = millis() / 1000;
  unsigned long dias = totalSegundos / 86400;
  unsigned long horas = (totalSegundos % 86400) / 3600;
  unsigned long minutos = (totalSegundos % 3600) / 60;
  char relogio[20];
  snprintf(relogio, sizeof(relogio), "%03lu:%02lu:%02lu", dias, horas, minutos);
  return String(relogio);
}
String getHoraSimuladaString() {
  char buf[10];
  snprintf(buf, sizeof(buf), "%02d:%02d", horaSimulada, minutoSimulado);
  return String(buf);
}
void processarIluminacao() {
  if (!cicloAuto) return; 
  if (modoIluminacao == "Cogumelos") {
    digitalWrite(LUZ_VERMELHA, HIGH);
    digitalWrite(LUZ_BRANCA2, HIGH);
    digitalWrite(LUZ_VIOLETA, HIGH);
    if (horaSimulada >= 6 && horaSimulada < 18) {
      if (digitalRead(LUZ_BRANCA1) == HIGH) {
        digitalWrite(LUZ_BRANCA1, LOW);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Dia iniciado (ciclo Cogumelos) (06:00 - 18:00). Luz Branca 1 LIGADA!");
      }
    } else {
      if (digitalRead(LUZ_BRANCA1) == LOW) {
        digitalWrite(LUZ_BRANCA1, HIGH);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Noite iniciada (ciclo Cogumelos). Luz Branca 1 DESLIGADA.");
      }
    }
  }  else if (modoIluminacao == "Plantas") {
    int mCurr = horaSimulada * 60 + minutoSimulado;
    int dMin = (int)(duracaoDia * 60.0);
    int mStart = 720 - (dMin / 2); 
    int mEnd = 720 + (dMin / 2);
    bool eNoite = (mCurr < mStart || mCurr >= mEnd);
    if (eNoite) {
      digitalWrite(LUZ_VERMELHA, HIGH);
      digitalWrite(LUZ_BRANCA1, HIGH);
      digitalWrite(LUZ_BRANCA2, HIGH);
      digitalWrite(LUZ_VIOLETA, HIGH);
    } else {
      int p10 = dMin * 0.10;
      int p4  = dMin * 0.04;
      bool verm = (mCurr < (mStart + p10)) || (mCurr >= (mEnd - p10));
      bool b1   = (mCurr >= (mStart + p4))  && (mCurr < (mEnd - p4));
      bool b2   = (mCurr >= (mStart + p10)) && (mCurr < (mEnd - p10));
      bool viol = (mCurr >= (720 - p10))    && (mCurr < (720 + p10));
      if (digitalRead(LUZ_BRANCA1) != (b1 ? LOW : HIGH)) {
        digitalWrite(LUZ_BRANCA1, b1 ? LOW : HIGH);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Luz Branca 1 " + (b1 ? "LIGADA" : "DESLIGADA") + " (ciclo Plantas).");
      }
      if (digitalRead(LUZ_BRANCA2) != (b2 ? LOW : HIGH)) {
        digitalWrite(LUZ_BRANCA2, b2 ? LOW : HIGH);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Luz Branca 2 " + (b2 ? "LIGADA" : "DESLIGADA") + " (ciclo Plantas).");
      }
      if (digitalRead(LUZ_VERMELHA) != (verm ? LOW : HIGH)) {
        digitalWrite(LUZ_VERMELHA, verm ? LOW : HIGH);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Luz Vermelha " + (verm ? "LIGADA" : "DESLIGADA") + " (ciclo Plantas).");
      }
      if (digitalRead(LUZ_VIOLETA) != (viol ? LOW : HIGH)) {
        digitalWrite(LUZ_VIOLETA, viol ? LOW : HIGH);
        logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] Luz Violeta " + (viol ? "LIGADA" : "DESLIGADA") + " (ciclo Plantas).");
      }
    }
  }
}
