void setup() {
  Serial.begin(115200); // Início da comunicação e configuração inicial dos pinos high = off
  Serial.setTimeout(5);
  pinMode(LED_BUILTIN_PIN, OUTPUT);
  pinMode(BTN_RESET, INPUT_PULLUP);
  pinMode(RELE_AQUECIMENTO, OUTPUT);
  pinMode(RELE_VENTILADOR, OUTPUT);
  pinMode(RELE_UMIDADE_1, OUTPUT);
  pinMode(RELE_UMIDADE_2, OUTPUT);
  pinMode(LUZ_BRANCA1, OUTPUT);
  pinMode(LUZ_VERMELHA, OUTPUT);
  pinMode(LUZ_BRANCA2, OUTPUT);
  pinMode(LUZ_VIOLETA, OUTPUT);
  pinMode(RELE_REFRIGERACAO, OUTPUT);
  pinMode(RELE_INJECAO_CO2, OUTPUT);
  digitalWrite(RELE_REFRIGERACAO, HIGH);
  digitalWrite(RELE_INJECAO_CO2, HIGH);
  digitalWrite(RELE_AQUECIMENTO, HIGH);
  digitalWrite(RELE_VENTILADOR, HIGH);
  digitalWrite(RELE_UMIDADE_1, HIGH);
  digitalWrite(RELE_UMIDADE_2, HIGH);
  digitalWrite(LUZ_BRANCA1, HIGH);
  digitalWrite(LUZ_VERMELHA, HIGH);
  digitalWrite(LUZ_BRANCA2, HIGH);
  digitalWrite(LUZ_VIOLETA, HIGH);
  delay(5000); // Pausa para conectar monitor serial cabeado
  logMessage("[GREENHOUSE] Sistema iniciando...");
  inicializarSD();
  delay(500);
  logMessage("[SISTEMA] Cultivo de " + modoIluminacao + " configurado.");
  // ---- AUTO-DETECÇÃO DE SENSOR (DHT11 ou SCD30) ----
  dht.begin();
  float testT = dht.readTemperature();
  float testU = dht.readHumidity();
  if (!isnan(testT) && !isnan(testU)) {
    usaDHT11 = true;
    logMessage("[SISTEMA] Sensor DHT11 detectado e em uso.");
  } else {
    Wire.begin(); 
    if (airSensor.begin()) {
      usaSCD30 = true;
      airSensor.setMeasurementInterval(2);
      logMessage("[SISTEMA] Sensor SCD30 ativado com sucesso via I2C!");
    } else {
      logMessage("[" + getHoraSimuladaString() + "] [SISTEMA] ERRO: Falha de leitura no sensor de ambiente!");
    }
  }
  // Configura conexão baseada na memória
  carregarConfiguracoesRede();
  prefs.begin("greenhouse", true);
  String savedPerfil = prefs.getString("perfil_ativo", "Frutificação");
  prefs.end();
  carregarPerfil(savedPerfil);
  WiFi.persistent(false); 
  if (modoWifi == 0) {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1); 
    logMessage("[REDE] Modo Apenas AP Ativo. IP: " + WiFi.softAPIP().toString());
  } else {
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP(ssidAP.c_str(), passAP.c_str(), 1); 
    logMessage("[REDE] AP de Emergência Habilitado: " + ssidAP + " (IP: " + WiFi.softAPIP().toString() + ")");
    if (ssidSTA.length() > 0) {
      logMessage("[REDE] Conectando à rede Wi-Fi: " + ssidSTA + "...");
      WiFi.begin(ssidSTA.c_str(), passSTA.c_str());
      tentandoConectarWifi = true;
      tempoInicioConexaoWifi = millis();
    } else {
      logMessage("[REDE] Modo Cliente selecionado, mas nenhum SSID configurado.");
    }
  }
// 
