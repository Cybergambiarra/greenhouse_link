// Rota Dedicada para Transmissão Incremental de Log Delta
void handleLog() {
  unsigned long desde = 0;
  if (server.hasArg("desde")) {
  desde = strtoul(server.arg("desde").c_str(), nullptr, 10);
  }
  
  String delta = "";
  if (desde < totalBytesLog) {
    unsigned long diff = totalBytesLog - desde;
    if (diff > serialBuffer.length()) {
      delta = serialBuffer;
    } else {
      size_t startPos = serialBuffer.length() - diff;
      delta = serialBuffer.substring(startPos);
    }
  }

  String deltaEscaped = delta;
  deltaEscaped.replace("\\", "\\\\");
  deltaEscaped.replace("\"", "\\\"");
  deltaEscaped.replace("\n", "\\n");
  deltaEscaped.replace("\r", "");

  String json = "{\"delta\":\"" + deltaEscaped + "\",\"pos\":" + String(totalBytesLog) + "}";
  server.send(200, "application/json", json);
}

