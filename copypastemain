function apagarArquivoSD(nomeArquivo) {
  // 1. Checa a trava no Frontend (utilize a variável global/função de verificação de bloqueio)
  if(painelBloqueado) {
    alert('Ação bloqueada! Desbloqueie o painel nas configurações para poder apagar arquivos.');
    return;
  }
  // 2. Confirmação de segurança para evitar exclusão acidental
  if (!confirm(`Deseja realmente apagar o arquivo "${nomeArquivo}" do cartão SD?`)) {
    return;
  }
  // 3. Envia requisição via POST para o ESP32
  fetch(`/deletar?file=${encodeURIComponent(nomeArquivo)}`, { method: 'POST' })
    .then(response => {
      if (response.ok) {
        alert('Arquivo excluído com sucesso!');
        // Atualiza a tabela recarregando a lista
        document.getElementById('historicoContainer').style.display = 'none';
        carregarHistoricoSD();
      } else {
        alert('Erro ao excluir arquivo no cartão SD.');
      }
    })
    .catch(err => alert('Erro de conexão ao tentar apagar: ' + err));
}
