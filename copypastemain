function fazerLogin() {
  let senha = prompt("Digite a senha do sistema:");
  if (!senha) return;
  let formData = new FormData();
  formData.append("pass", senha);
  fetch('/login', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(d => {
      if (d.status === 'ok') {
        alert('Autenticação realizada com sucesso!');
        atualizarStatus();
      } else if (d.status === 'bloqueado') {
        alert('Acesso temporariamente bloqueado por força bruta! Aguarde ' + d.restante + ' segundos.');
      } else {
        alert('Senha incorreta! Tentativa ' + d.tentativas + ' de 3.');
      }
    })
    .catch(() => alert('Erro de comunicação com o ESP32.'));
}

function alterarSenha() {
  let novaSenha = prompt("Digite a nova senha do sistema (mínimo 6 caracteres):");
  if (!novaSenha) return;
  if (novaSenha.length < 6) {
    alert("A senha deve ter no mínimo 6 caracteres!");
    return;
  }
  let formData = new FormData();
  formData.append("pass", novaSenha);
  fetch('/set_sys_pass', { method: 'POST', body: formData })
    .then(r => {
      if (r.ok) {
        alert("Nova senha salva com sucesso na memória NVS!");
      } else if (r.status === 403) {
        alert("Acesso Negado! Faça o login primeiro antes de alterar a senha.");
      } else {
        alert("Erro ao alterar a senha. A senha deve ter no mínimo 6 caracteres.");
      }
    })
    .catch(() => alert("Erro de comunicação com o ESP32."));
}

function atualizarStatus() {
