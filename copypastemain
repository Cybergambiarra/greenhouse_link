void handleSetPerfil() {
  if (configuracoesDesbloqueadas && server.hasArg("p")) {
    String p = server.arg("p");
    String novoPerfil = "";
    if (p == "inc") novoPerfil = "Incubação";
    else if (p == "frut") novoPerfil = "Frutificação";
    else if (p == "pers") novoPerfil = "Personalizado";
    if (novoPerfil != "") {
      carregarPerfil(novoPerfil); // Carrega o perfil salvo da memória
      prefs.begin("greenhouse", false);
      prefs.putString("perfil_ativo", novoPerfil);
      prefs.end();
      logMessage("[CONFIG] Perfil alterado para " + perfilAtivo + getClientDetails());
    }
  }
  server.send(200, "text/plain", "OK");
}
// Handlers de Segurança & Configuração
void handleSetSenha() {
  if (configuracoesDesbloqueadas && server.hasArg("pass")) {
    String novaPass = server.arg("pass");
    if (novaPass.length() >= 4) {
      senhaAcesso = novaPass;
      prefs.begin("greenhouse", false);
      prefs.putString("senha_acesso", senhaAcesso);
      prefs.end();
      logMessage("[SEGURANÇA] Senha de acesso alterada com sucesso." + getClientDetails());
      server.send(200, "text/plain", "OK");
    } else {
      logMessage("[SEGURANÇA] [ERRO] A nova senha deve ter pelo menos 4 caracteres." + getClientDetails());
      server.send(400, "text/plain", "Senha curta");
    }
  } else {
    server.send(403, "text/plain", "Acesso Negado");
  }
}
void handleDesbloquear() {
  if (server.hasArg("pass")) {
    String p = server.arg("pass");
    if (p == senhaAcesso) {
      configuracoesDesbloqueadas = true;
      automacaoAtiva = false;
      logMessage("[SEGURANÇA] Configurações desbloqueadas com sucesso!" + getClientDetails());
      server.send(200, "text/plain", "OK");
    } else {
      logMessage("[SISTEMA] Acesso negado! Senha incorreta!" + getClientDetails());
      server.send(401, "text/plain", "Senha incorreta");
    }
  } else {
    server.send(400, "text/plain", "Bad Request");
  }
}
void handleBloquear() {
  configuracoesDesbloqueadas = false;
  automacaoAtiva = true;
  digitalWrite(RELE_UMIDADE_1, HIGH);
  digitalWrite(RELE_UMIDADE_2, HIGH); 
  etapaUmidade = 0;
  processarIluminacao();
  logMessage("[SEGURANÇA] Configurações bloqueadas manualmente." + getClientDetails());
  server.send(200, "text/plain", "OK");
  delay(500);
}
