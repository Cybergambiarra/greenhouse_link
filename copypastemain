// Rota de Autenticação de Usuário e Controle Anti-Força Bruta
void handleLogin() {
  unsigned long agora = millis();
  
  // Bloqueio temporário de 120s após 3 tentativas erradas
  if (tentativasFalhasAuth >= 3) {
    if (agora - tempoBloqueioAuth < 120000) {
      unsigned long restante = (120000 - (agora - tempoBloqueioAuth)) / 1000;
      logMessage("[AUTH] Tentativa bloqueada por força bruta! IP: " + server.client().remoteIP().toString());
      server.send(429, "application/json", "{\"status\":\"bloqueado\",\"restante\":" + String(restante) + "}");
      return;
    } else {
      tentativasFalhasAuth = 0; // Libera a trava após decorridos 120s
    }
  }

  if (server.hasArg("pass")) {
    String p = server.arg("pass");
    String user = (server.hasArg("user") && server.arg("user").length() > 0) ? server.arg("user") : "Anônimo";
    String ip = server.client().remoteIP().toString();
    String ua = server.header("User-Agent"); // Dispositivo / Navegador

    if (p == senhaSistema) {
      tentativasFalhasAuth = 0;
      modoManualAutenticado = true;
      logMessage("[AUTH] Login OK! IP: " + ip + " | Usuário: " + user + " | Dispositivo: " + ua);
      server.send(200, "application/json", "{\"status\":\"ok\"}");
    } else {
      tentativasFalhasAuth++;
      if (tentativasFalhasAuth >= 3) tempoBloqueioAuth = agora;
      logMessage("[AUTH] Senha Incorreta! IP: " + ip + " | Usuário: " + user + " (Tentativa " + String(tentativasFalhasAuth) + "/3)");
      server.send(401, "application/json", "{\"status\":\"erro\",\"tentativas\":" + String(tentativasFalhasAuth) + "}");
    }
  } else {
    server.send(400, "application/json", "{\"status\":\"invalid\"}");
  }
}

