// --- BUFFER DE ESCRITA EM LOTE DO CARTÃO SD (Batch Writing) ---
const size_t SD_BATCH_SIZE = 512; // 512 bytes = 1 setor físico do SD
char sdBatchBuffer[SD_BATCH_SIZE];
