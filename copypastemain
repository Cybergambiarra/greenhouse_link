// 3. API JSON que retorna a lista de arquivos salvos no SD
void handleApiListarLogs() {
  if (!sdDisponivel) {
    server.send(500, "application/json", "[]");
    return;
  }
  String json = "[";
  File root = SD.open("/");
  File file = root.openNextFile();
  bool primeiro = true;
  while (file) {
    if (!file.isDirectory()) {
      if (!primeiro) json += ",";
      String nome = String(file.name());
      if (!nome.startsWith("/")) nome = "/" + nome;
      json += "{\"nome\":\"" + nome + "\",\"tamanho\":" + String(file.size()) + "}";
      primeiro = false;
    }
  File proximo = root.openNextFile();
  file.close(); // Fecha o arquivo processado antes de avançar
  file = proximo;
  }
  json += "]";
  server.send(200, "application/json", json);
}
// 4. Baixar ou visualizar qualquer arquivo específico passado via URL 
void handleArquivoEspecifico() {
  if (!server.hasArg("file")) {
    server.send(400, "text/plain", "Parametro 'file' ausente.");
    return;
  }
  String path = server.arg("file");
  if (!SD.exists(path)) {
    server.send(404, "text/plain", "Arquivo nao encontrado.");
    return;
  }
  File file = SD.open(path, FILE_READ);
  if (server.hasArg("download")) {
    String nome = path.startsWith("/") ? path.substring(1) : path;
    server.sendHeader("Content-Type", "text/plain");
    server.sendHeader("Content-Disposition", "attachment; filename=" + nome);
    server.streamFile(file, "application/octet-stream");
  } else {
    server.streamFile(file, "text/plain; charset=utf-8");
  }
  file.close();
}
// 5. Deletar arquivo
 void handleDeletarArquivo(){
  if (!configuracoesDesbloqueadas) {
    server.send(403, "text/plain", "Bloqueado: Painel travado");
    return;
  }
  if (server.hasArg("file")) {
    String path = server.arg("file");
    if (!path.startsWith("/")) path = "/" + path;
    if (SD.exists(path)) {
      if (SD.remove(path)) {
        logMessage("Arquivo " + path + " removido via Web Interface." + getClientDetails());
        server.send(200, "text/plain", "OK");
      } else {
        server.send(500, "text/plain", "Falha ao deletar arquivo");
      }
    } else {
      server.send(404, "text/plain", "Arquivo nao encontrado");
    }
  } else {
    server.send(400, "text/plain", "Parametro ausente");
  }
}
