      logMessage("[REDE] Novas credenciais AP salvas! Reinicie o ESP32 para aplicar." + getClientDetails());
    } else {
      logMessage("[ERRO] Senha do AP precisa ter no mínimo 8 caracteres!" + getClientDetails());
    }
  }
  server.sendHeader("Location", "/");
  server.send(303);
}
// Aplica nome de rede e senha para conectar modo cliente STA
void handleSetStaCreds() {
  if (server.hasArg("ssid") && server.hasArg("pass")) {
    ssidSTA = server.arg("ssid");
    passSTA = server.arg("pass");
    modoWifi = 1;
    prefs.begin("greenhouse", false);
    prefs.putString("ssid_sta", ssidSTA);
    prefs.putString("pass_sta", passSTA);
    prefs.putInt("modo_wifi", modoWifi);
    prefs.end();
    logMessage("[REDE] Credenciais Wi-Fi e Modo Cliente salvos! Reinicie o ESP32 para conectar." + getClientDetails());
  }
  server.sendHeader("Location", "/");
  server.send(303);
}
// Handle do reset do perfil em uso (acho que da pra reduzir isso aqui juntando no comando de memória)
void handleRestaurarPerfil() {
  if (configuracoesDesbloqueadas) {
    restaurarFabricaPerfilAtivo();
    logMessage("[CONFIG] Padrões de fábrica restaurados para o perfil " + perfilAtivo + getClientDetails());
  }
  server.send(200, "text/plain", "OK");
}
// Atuador de restart
void handleRestart() {
  logMessage("[SISTEMA] Reinicialização solicitada via Web interface..." + getClientDetails());
  server.send(200, "text/plain", "OK");
  delay(100);
  ESP.restart();
}
